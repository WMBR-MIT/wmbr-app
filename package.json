{
  "name": "WmbrApp",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "npx react-native bundle --entry-file index.ts --platform ios --dev true --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios/assets",
    "bundle:android": "npx react-native bundle --entry-file index.ts --platform android --dev true --bundle-output dist/android/main.jsbundle --assets-dest dist/android/assets",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.28",
    "he": "^1.2.0",
    "react": "19.2.3",
    "react-native": "^0.84.1",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.24.0",
    "react-native-sfsymbols": "^1.2.2",
    "react-native-svg": "^15.15.1",
    "react-native-track-player": "^4.1.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "0.12.2",
    "react-native-xml2js": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.0",
    "@react-native-community/cli-platform-android": "^20.1.0",
    "@react-native-community/cli-platform-ios": "^20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/gradle-plugin": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@testing-library/react-native": "^13.3.0",
    "@types/he": "^1.2.3",
    "@types/jest": "^29.5.13",
    "@types/react": "19.2.3",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.1",
    "prettier-eslint": "^16.4.2",
    "react-native-cli-bump-version": "^1.5.1",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npx eslint --fix"
    ]
  }
}
